# PQCSecure: recommended git ignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.venv312/

# Python distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.whl

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checker / cache directories
.mypy_cache/
.pyre/

# Local environment variables
.env
.env.*
!.env.example
instance/

# Logs
*.log

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Node / frontend
node_modules/
dist/
build/
.cache/
.npm/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# OS files
.DS_Store
Thumbs.db
desktop.ini
~$*

# Ignore generated model/dataset artifacts to avoid committing large binaries
# (untrack explicitly if already committed)
/pqcsecure-backend/*.pkl
/pqcsecure-backend/*.meta.json
/pqcsecure-backend/stego_*.pkl
*.histogram_recovered

# Project-specific generated artifacts
final-project.pptx
recovered_dashboard_full.txt
sample.png
pi_benchmark/

# Keep source files tracked
# Do not ignore actual backend source or tests
